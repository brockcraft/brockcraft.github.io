---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Lifelong Learning Challenge Game" description="Download the artwork for the Lifelong Learning Challenge Game card deck">
  <h1 style="text-align: center;">Lifelong Learning Challenge Game Card Deck</h1>
  <div style="display: flex; flex-wrap: wrap; gap: 1rem; justify-content: center; align-items: center; margin: 2.5rem auto;">
    <img src="/assets/LLC_GAME_TITLECARD.png" alt="Lifelong Learning Challenge Game Title Card" style="height: 300px; width: auto; max-width: 100%;">
    <img src="/assets/LLC_GAME_OVERVIEW.jpg" alt="Lifelong Learning Challenge Game Overview Card" style="height: 300px; width: auto; max-width: 100%;">
  </div>
  <p style="text-align: center; width: clamp(280px, 50%, 600px); max-width: 90%; margin: 2.5rem auto;">This file contains the artwork for the Lifelong Learning Challenge Game card deck that can be printed as physical cards at vendors such as <a href="https://carddeckprinting.com" target="_blank" rel="noopener noreferrer">carddeckprinting.com</a>.</p>
  <p style="text-align: center;"><a href="/docs/LLC_GAME_(v3).pdf" download class="download-link" style="font-size: 1.25rem; font-weight: bold;">Download PDF</a></p>
</BaseLayout>